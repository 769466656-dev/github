# Copy this file to .env and replace only on your local computer.
# Never commit .env or real credentials.
WUCAI_SQL_HOST=<localhost>
WUCAI_SQL_USERNAME=<your_mysql_username>
WUCAI_SQL_PASSWORD=<replace_with_local_password>
WUCAI_SQL_PORT=<3306>
WUCAI_SQL_DB=<wucai_trade>

# Optional backtest settings
BACKTEST_INITIAL_CASH=<100000>
BACKTEST_COMMISSION=<0.0003>
BACKTEST_POSITION_PCT=<0.2>
